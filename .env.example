# secureprompt environment configuration
# Copy to .env and fill in real values for local development
# NEVER commit .env — only .env.example is tracked in git
#
# First run:
#   cp .env.example .env
#   docker compose config   # validates the file; should exit 0 with no errors
#   docker compose up
# The secrets below are freshly generated, working values so the commands
# above succeed immediately for local/single-dev use. Regenerate every one
# of them (`openssl rand -hex 32`, or per the LibreChat block below) before
# sharing this .env or deploying anywhere beyond your own machine.

# Used only when you run the Rust binaries or `cargo test` ON THE HOST.
# docker-compose.yml sets DATABASE_URL explicitly per service and ignores this.
#
# This is the OWNER/MIGRATOR role deliberately: `#[sqlx::test]` provisions a
# database per test and so needs CREATEDB, and a host-run binary against a
# fresh database has to be able to create the schema.
DATABASE_URL=postgres://secureprompt:secureprompt@localhost:5432/secureprompt
REDIS_URL=redis://localhost:6379

# WS1-P0 DB ROLE SPLIT. In compose, `db-migrate` applies the schema as the
# owner role and sets THIS password on the runtime role `secureprompt_app`;
# the api and worker DATABASE_URLs are built from the same variable, so the
# role and the URL cannot drift apart.
#
# The runtime role is NOSUPERUSER + NOBYPASSRLS and owns no table, which is
# what makes the row-level security policies on this schema apply at all — a
# superuser bypasses them unconditionally, which is what the single-role
# stack did.
#
# `./scripts/init-env.sh` fills this in with a generated value. By hand:
# openssl rand -hex 32. Left unset, docker-compose.yml falls back to the same
# throwaway dev password as the owner role.
SECUREPROMPT_APP_DB_PASSWORD=CHANGEME

LOG_LEVEL=info
HOST=0.0.0.0
PORT=8080

OTEL_ENABLED=false
PROMETHEUS_ENABLED=false

# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=...

# Gateway secrets. These are DELIBERATELY placeholders that the boot gate
# (secureprompt-common/src/config.rs, PLACEHOLDER_SECRETS) REJECTS, so a
# copied-but-unedited file fails loudly instead of running on a secret that
# is published in this repo.
#
# Do not replace them with generated values here — a secret committed to a
# template is shared by every deployment that copies it, and a random-looking
# hex string is worse than CHANGEME because nothing signals it needs changing.
#
# Run `./scripts/init-env.sh` to generate a .env with fresh secrets locally.
SECUREPROMPT_JWT_SECRET=CHANGEME
SECUREPROMPT_PROVIDER_KEY=CHANGEME

# Shared secret between the gateway (api/worker/web) and the Python ML
# sidecar — sent as `Authorization: Bearer <value>` on every internal
# request. docker-compose.yml requires this (`${ML_SIDECAR_INTERNAL_TOKEN:?...}`)
# with no fallback default by design, so it MUST be set for `docker compose
# config`/`up` to succeed at all. `./scripts/init-env.sh` fills it in;
# by hand: openssl rand -hex 32
ML_SIDECAR_INTERNAL_TOKEN=CHANGEME

# NextAuth secrets — replace CHANGEME before deploying
NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://localhost:3000
API_URL=http://localhost:8080

# Phase 1 chat debug mode. When `true`, /v1/chat/completions runs the full
# redaction pipeline but does NOT call the cloud provider — instead it returns
# the tokenized prompt + provider invocation body as the assistant message.
# Used to verify the LibreChat → SecurePrompt round-trip end-to-end before
# cloud adapters are wired. Defaults to `false`. Truthy values: 1, true, yes.
SECUREPROMPT_CHAT_DEBUG_MODE=false

# -----------------------------------------------------------------------------
# LibreChat stack (task 30) — used by the `librechat-mongo`, `librechat`, and
# `librechat-nginx` services in docker-compose.yml. These secrets are
# LibreChat-internal and have NO relationship to the SP secrets above. Replace
# every CHANGEME before bringing the stack up — see SP integration docs for
# the openssl one-liner that fills all five at once.
# -----------------------------------------------------------------------------
DOMAIN=localhost

# Mongo root user — `librechat` connects with these creds via MONGO_URI.
# Once the volume is initialized this password is baked in; rotating it
# requires `docker compose down -v librechat-mongo` (DESTRUCTIVE).
MONGO_ROOT_USERNAME=librechat
MONGO_PASSWORD=CHANGEME

# JWT signing secrets for LibreChat-issued user sessions. Generate with:
#   openssl rand -base64 32
# Must be different from each other.
LIBRECHAT_JWT_SECRET=CHANGEME
LIBRECHAT_JWT_REFRESH_SECRET=CHANGEME

# AES-256 key + IV that LibreChat uses to encrypt user-supplied provider
# credentials at rest in MongoDB. Hex-encoded.
#   openssl rand -hex 32   → CREDS_KEY (32 bytes / 64 hex chars)
#   openssl rand -hex 16   → CREDS_IV  (16 bytes / 32 hex chars)
LIBRECHAT_CREDS_KEY=CHANGEME
LIBRECHAT_CREDS_IV=CHANGEME

# When true (default), every chat attachment is POSTed to SP `/v1/scan-file`
# for PII redaction before reaching the cloud provider. Set to `false` only
# for local debugging without an SP backend.
SECUREPROMPT_SCAN_FILES_ENABLED=true

# Environment files — never commit real credentials
.env
.env.local
.env.production
**/.env.local

# Next.js build output and test artefacts
secureprompt-web/.next/
secureprompt-web/playwright-report/
secureprompt-web/test-results/

# Rust build artifacts
/target/

# SQLx offline query cache — commit this intentionally for CI offline mode
# .sqlx/  (keep tracked)

# IDE files
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# dbt profiles — contain credentials via env vars; never commit
secureprompt-analytics/profiles.yml
.worktrees/

# LibreChat fork — tracked as its own git repo; do not commit into parent
secureprompt-chat/


# Python caches and venvs (added for SP session work)
**/__pycache__/
*.pyc
.venv-pf/
.venv-train/

# Local model resources / runtime data
secureprompt-ml/app/resources/
data/
out/

# dbt local user config + logs
secureprompt-analytics/.user.yml
secureprompt-analytics/logs/

# Per-deployment env override
.env.librechat

# Claude Code agent worktrees (ephemeral, not source)
.claude/worktrees/

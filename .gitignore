# Environment files — never commit real credentials
.env
.env.local
.env.production
**/.env.local

# Next.js build output and test artefacts
secureprompt-web/.next/
secureprompt-web/playwright-report/
secureprompt-web/test-results/

# Rust build artifacts
/target/

# SQLx offline query cache — commit this intentionally for CI offline mode
# .sqlx/  (keep tracked)

# IDE files
.idea/
.vscode/
*.iml

# macOS
.DS_Store

# dbt profiles — contain credentials via env vars; never commit
secureprompt-analytics/profiles.yml
.worktrees/


# Python caches and venvs (added for SP session work)
**/__pycache__/
*.pyc
.venv-pf/
.venv-train/
.venv-dvc/

# Local model resources / runtime data
# NOTE: "/*" (not a bare dir match) so DVC .dvc pointer files can be
# re-included below — git cannot re-include a path whose parent dir is
# excluded, so the trailing /* excludes CONTENTS rather than the dir itself.
secureprompt-ml/app/resources/*
!secureprompt-ml/app/resources/*.dvc
!secureprompt-ml/app/resources/.gitignore
data/
out/

# Local model training/versioning pipeline — kept on disk for reproducibility
# of the shipped checkpoint, not committed (the model is built into the image
# from app/resources/ separately). The legacy v2/v3 trainers were removed.
scripts/*_v4*.py
scripts/*_v5*.py
scripts/*_v6*.py
scripts/gen_prompt_v5.txt
scripts/run_v5_*.sh

# dbt local user config + logs
secureprompt-analytics/.user.yml
secureprompt-analytics/logs/

# Per-deployment env override
.env.librechat

# Claude Code agent state (ephemeral, not source)
.claude/
.claude/worktrees/

# TypeScript / Next.js incremental build artefacts
*.tsbuildinfo
next-env.d.ts
**/.next/
**/node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS junk
Thumbs.db
ehthumbs.db
Desktop.ini

# Editor swap files
*.swp
*.swo
*~
.gstack/

# Local secret material (license keys, Cloudflare origin cert, model key)
secrets/

# License material + generated TLS certs (secrets — never commit)
etc/secureprompt/
monitoring/nginx/certs/

# graphify tool cache (regenerable)
graphify-out/cache/
scripts/v6_*.py

# Local backup/restore test artifacts (encrypted dumps produced by
# scripts/backup/*.sh against a running dev stack — not source)
/backups/
/data

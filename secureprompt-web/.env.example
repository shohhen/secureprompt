# Rust gateway base URL (used by NextAuth authorize() and server components)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Shared secret for NextAuth JWT signing (NOT the Rust JWT secret — different key).
# Must be >=16 chars; generate a strong secret with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGEME-CHANGEME-CHANGEME
NEXTAUTH_URL=http://localhost:3000
